{
  "name": "@boole/boole-ai",
  "version": "0.6.4",
  "description": "Run AI models at the edge with zero network latency. TypeScript SDK for local-first LLM inference via llama.cpp/GGUF — no cold starts, no round-trips, no cloud dependency.",
  "license": "MIT",
  "author": "Boole AI",
  "homepage": "https://github.com/boole-ai/boole-npm#readme",
  "bugs": {
    "url": "https://github.com/boole-ai/boole-npm/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "node-llama-cpp": "^3.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.17.6",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "keywords": [
    "edge-ai",
    "edge-deployment",
    "local-ai",
    "on-device-ai",
    "low-latency",
    "real-time-ai",
    "local-first",
    "offline-ai",
    "self-hosted-ai",
    "llama.cpp",
    "gguf",
    "local-llm",
    "llm",
    "inference",
    "typescript",
    "nodejs",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boole-ai/boole-npm.git"
  }
}